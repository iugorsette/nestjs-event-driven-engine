{
  "name": "high-throughput-event-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Event-driven processing engine built with NestJS and TypeScript.",
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "tsc -p tsconfig.spec.json && node --test dist-test/test/*.spec.js",
    "test:redis": "tsc -p tsconfig.spec.json && node --test dist-test/test/integration/*.spec.js",
    "start": "nest start --env-file .env",
    "start:dev": "nest start --watch --env-file .env",
    "start:worker": "nest start --entryFile worker --env-file .env",
    "start:worker:dev": "nest start --watch --entryFile worker --env-file .env",
    "start:worker:prod": "node dist/worker.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/observe": "^0.3.26",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.8.0",
    "bullmq": "^5.81.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/hpp": "^0.2.6",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
